    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

    <script>
        // Регистрация плагина прокрутки
        gsap.registerPlugin(ScrollTrigger);

        document.addEventListener("DOMContentLoaded", () => {
       // 1. Инициализация GSAP Анимаций при скролле
            const sections = document.querySelectorAll('.section-animate');
            
            sections.forEach((section, index) => {
                gsap.to(section, {
                    scrollTrigger: {
                        trigger: section,
                        start: "top 85%",
                        toggleActions: "play none none reverse"
                    },
                    opacity: 1,
                    y: 0,
                    duration: 0.8,
                    ease: "power2.out",
                    delay: index * 0.05 // Небольшая задержка для эффекта каскада
                });
            });

            // 2. Инициализация Three.js Background
            const initThreeJS = () => {
                const container = document.getElementById('canvas-container');
                const scene = new THREE.Scene();
                
                // Настройка камеры
                const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
                camera.position.z = 15;

                // Настройка рендера
                const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
                renderer.setSize(window.innerWidth, window.innerHeight);
                renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
                container.appendChild(renderer.domElement);

                // Освещение (теплые тона)
                const ambientLight = new THREE.AmbientLight(0xffefdb, 0.6); // Теплый мягкий свет
                scene.add(ambientLight);

                const directionalLight = new THREE.DirectionalLight(0xffa154, 0.8);
                directionalLight.position.set(10, 20, 10);
                scene.add(directionalLight);

                const pointLight = new THREE.PointLight(0xff852c, 0.5);
                pointLight.position.set(-10, -10, 10);
                scene.add(pointLight);

                // Создание объектов (символизируют физику и архипелаг)
                const objects = [];
                const material1 = new THREE.MeshStandardMaterial({ 
                    color: 0xffb366, 
                    roughness: 0.3,
                    metalness: 0.1
                });
                const material2 = new THREE.MeshStandardMaterial({ 
                    color: 0xffd9b3, 
                    roughness: 0.4,
                    metalness: 0.2
                });
                const material3 = new THREE.MeshStandardMaterial({ 
                    color: 0xfa9856, 
                    roughness: 0.2,
                    metalness: 0.1,
                    wireframe: true // Для технического/физического вида
                });

                // Сфера (Планета/атом)
                const geometrySphere = new THREE.SphereGeometry(2, 32, 32);
                const sphere = new THREE.Mesh(geometrySphere, material1);
                sphere.position.set(-8, 5, -5);
                scene.add(sphere);
                objects.push(sphere);

                // Куб (Механика/блок)
                const geometryBox = new THREE.BoxGeometry(3, 3, 3);
                const box = new THREE.Mesh(geometryBox, material2);
                box.position.set(10, -4, -8);
                scene.add(box);
                objects.push(box);

                // Икосаэдр (Кристаллы/Сложные структуры)
                const geometryIcosahedron = new THREE.IcosahedronGeometry(2.5, 0);
                const icosa = new THREE.Mesh(geometryIcosahedron, material3);
                icosa.position.set(-6, -6, -2);
                scene.add(icosa);
                objects.push(icosa);

                // Тор (Магнитное поле/волны)
                const geometryTorus = new THREE.TorusGeometry(3, 0.8, 16, 100);
                const torus = new THREE.Mesh(geometryTorus, material2);
                torus.position.set(8, 6, -10);
                scene.add(torus);
                objects.push(torus);

                // Анимация
                const animate = () => {
                    requestAnimationFrame(animate);

                    // Медленное вращение объектов
                    sphere.rotation.x += 0.002;
                    sphere.rotation.y += 0.003;
                    sphere.position.y += Math.sin(Date.now() * 0.001) * 0.01;

                    box.rotation.x -= 0.003;
                    box.rotation.y -= 0.002;
                    box.position.y += Math.cos(Date.now() * 0.001) * 0.01;

                    icosa.rotation.x += 0.001;
                    icosa.rotation.y -= 0.004;

                    torus.rotation.x += 0.002;
                    torus.rotation.z += 0.001;

                    // Параллакс эффект от мыши
                    scene.rotation.y = mouseX * 0.05;
                    scene.rotation.x = mouseY * 0.05;

                    renderer.render(scene, camera);
                };

                // Отслеживание мыши для параллакса
                let mouseX = 0;
                let mouseY = 0;
                document.addEventListener('mousemove', (event) => {
                    mouseX = (event.clientX / window.innerWidth) * 2 - 1;
                    mouseY = -(event.clientY / window.innerHeight) * 2 + 1;
                });

                // Адаптация при изменении размера окна
                window.addEventListener('resize', () => {
                    camera.aspect = window.innerWidth / window.innerHeight;
                    camera.updateProjectionMatrix();
                    renderer.setSize(window.innerWidth, window.innerHeight);
                });

                animate();
            };

            // Запускаем 3D фон
            initThreeJS();
        });
    </script>
